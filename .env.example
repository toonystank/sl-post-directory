# Database (Neon Postgres)
DATABASE_URL=""

# NextAuth Authentication (generate via `openssl rand -base64 32`)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Optional dedicated AES-256-GCM encryption master key for stored 2FA TOTP secrets (defaults to NEXTAUTH_SECRET)
TWO_FACTOR_ENCRYPTION_KEY=""
# Optional separate secret for SLP Courier CAPTCHA session signing (defaults to NEXTAUTH_SECRET)
TRACKING_SESSION_SECRET=""

# Email Delivery — Option A: Resend HTTP API (recommended once your custom domain is verified)
RESEND_API_KEY=""
EMAIL_FROM=""

# Email Delivery — Option B: Standard SMTP (e.g. Brevo free SMTP or Gmail App Password)
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""

# Upstash Redis (distributed rate limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Set "true" only when traffic is strictly fronted by Cloudflare proxy (protects CF-Connecting-IP spoofing)
TRUST_CLOUDFLARE_HEADERS="false"

# Cloudflare Turnstile (bot protection on register, suggest, reviews, photos)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Uploadcare (community photos)
NEXT_PUBLIC_UPLOADCARE_PUB_KEY=""
NEXT_PUBLIC_UPLOADCARE_CDN=""
UPLOADCARE_SECRET_KEY=""

# Gemini AI OCR (optional receipt/address scan fallback; client OCR runs locally without this)
GEMINI_API_KEY=""
GEMINI_OCR_MODEL=""
GEMINI_OCR_HOURLY_CAP="500"

# Canonical Site Origin & Support Contact (update when switching to your custom domain!)
NEXT_PUBLIC_SITE_URL="https://lankapost.vercel.app"
NEXT_PUBLIC_CONTACT_EMAIL=""

# Monetization & Analytics
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-2503310431210239"
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Google Play Store TWA (Digital Asset Links: /.well-known/assetlinks.json)
TWA_ANDROID_PACKAGE_NAME="com.toonystank.slpostdirectory"
TWA_SHA256_CERT_FINGERPRINTS=""
NEXT_PUBLIC_DISABLE_ADS_IN_TWA="false"
